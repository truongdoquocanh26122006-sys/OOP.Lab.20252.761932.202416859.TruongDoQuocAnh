<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="768.0" prefWidth="1024.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox>
            <MenuBar>
                <menus>
                    <Menu text="Options">
                        <items>
                            <Menu text="Update Store">
                                <items>
                                    <MenuItem text="Add Book" onAction="#addBook"/>
                                    <MenuItem text="Add CD"   onAction="#addCD"/>
                                    <MenuItem text="Add DVD"  onAction="#addDVD"/>
                                </items>
                            </Menu>
                            <MenuItem text="View Store" onAction="#viewStore"/>
                            <MenuItem text="View Cart"  onAction="#viewCart"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>
            <Label text="CART"
                   style="-fx-font-size: 50px; -fx-text-fill: #00ffff; -fx-padding: 0 0 0 10;"/>
        </VBox>
    </top>
    <center>
        <VBox style="-fx-padding: 0 0 0 10;">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 0 10 0;">
                <Label text="Filter:"/>
                <TextField fx:id="tfFilter"/>
                <RadioButton text="By ID" selected="true" fx:id="radioBtnFilterId">
                    <toggleGroup><ToggleGroup fx:id="filterCategory"/></toggleGroup>
                </RadioButton>
                <RadioButton text="By Title" fx:id="radioBtnFilterTitle">
                    <toggleGroup><fx:reference source="filterCategory"/></toggleGroup>
                </RadioButton>
            </HBox>
            <TableView fx:id="tblMedia" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMediaTitle" text="Title"/>
                    <TableColumn fx:id="colMediacategory" text="Category"/>
                    <TableColumn fx:id="colMediaCost" text="Cost"/>
                </columns>
            </TableView>
            <ButtonBar style="-fx-padding: 5 0 5 0;">
                <buttons>
                    <Button fx:id="btnPlay" text="Play" onAction="#btnPlayPressed"/>
                    <Button fx:id="btnRemove" text="Remove" onAction="#btnRemovePressed"/>
                </buttons>
            </ButtonBar>
        </VBox>
    </center>
    <right>
        <VBox alignment="TOP_CENTER" style="-fx-padding: 50 10 0 10;">
            <HBox alignment="CENTER" spacing="10">
                <Label text="Total:" style="-fx-font-size: 24px;"/>
                <Label fx:id="labelTotal" text="0 $"
                       style="-fx-font-size: 24px; -fx-text-fill: #00ffff;"/>
            </HBox>
            <Button text="Place Order" onAction="#btnPlaceOrderPressed"
                    style="-fx-font-size: 24px; -fx-text-fill: white; -fx-background-color: red;"/>
        </VBox>
    </right>
</BorderPane>
